erDiagram
    CLUBES ||--o{ JOGADORES : possui
    CLUBES ||--o{ PARTIDAS : mandante
    CLUBES ||--o{ PARTIDAS : visitante
    JOGADORES ||--o{ GOLS : marca
    PARTIDAS ||--o{ GOLS : registra

    CLUBES {
        BIGINT id_clube PK "IDENTITY; NOT NULL"
        VARCHAR nome UK "100; NOT NULL; UNIQUE"
        VARCHAR cidade "80; permite NULL"
    }

    JOGADORES {
        BIGINT id_jogador PK "IDENTITY; NOT NULL"
        VARCHAR nome "100; NOT NULL"
        VARCHAR posicao "20; NOT NULL; CHECK posicoes"
        BIGINT id_clube FK "NOT NULL; ON DELETE RESTRICT"
    }

    PARTIDAS {
        BIGINT id_partida PK "IDENTITY; NOT NULL"
        BIGINT id_mandante FK "NOT NULL; ON DELETE RESTRICT"
        BIGINT id_visitante FK "NOT NULL; ON DELETE RESTRICT"
        INTEGER rodada "NOT NULL; maior que zero"
        DATE data_partida "NOT NULL"
        VARCHAR status "10; NOT NULL; DEFAULT ABERTA"
        INTEGER gols_mandante "NULL se ABERTA; >= 0 se FINALIZADA"
        INTEGER gols_visitante "NULL se ABERTA; >= 0 se FINALIZADA"
    }

    GOLS {
        BIGINT id_gol PK "IDENTITY; NOT NULL"
        BIGINT id_partida FK "NOT NULL; ON DELETE RESTRICT"
        BIGINT id_jogador FK "NOT NULL; ON DELETE RESTRICT"
        SMALLINT minuto "NOT NULL; BETWEEN 1 AND 130"
    }